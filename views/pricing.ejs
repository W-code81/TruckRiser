<%- include("./partials/header.ejs") %>

  <div class="pricing-page">
    <div class="pricing-stripe"></div>

    <div class="pricing-hero">
      <span class="pricing-badge">Pricing</span>
      <h1>Simple, <span class="pricing-accent">transparent</span> pricing</h1>
      <p>Choose the plan that fits your rental needs. No hidden fees.</p>
    </div>

    <div class="pricing-grid" id="pricing-grid">
      <div class="pricing-loading">Loading plans...</div>
    </div>

    <p class="pricing-note">All prices are in Nigerian Naira (NGN). Payments are processed securely via Paystack.</p>
    <div class="pricing-stripe"></div>
  </div>

  <div id="app" data-user='<%- JSON.stringify(currentUser || null) %>'></div>

  <script src="/js/pricing.js"></script>
  <%- include("./partials/footer.ejs") %>